# Server encryption key for API key storage (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your-64-char-hex-key-here

# Server port (default: 3001)
PORT=3001

# Comma-separated extra origins allowed to call the API from a browser.
# localhost:5173, 127.0.0.1:5173, [::1]:5173 are allowed by default for the
# Vite dev dashboard. Only set this if you serve the dashboard from a
# different host than the API (e.g. http://pi.local).
# DASHBOARD_ORIGINS=http://pi.local,http://192.168.1.50

# --- Telegram notifications (outbound only) ---------------------------------
# Create a bot with @BotFather to get the token, then message your bot once and
# read your numeric chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
# (the "chat":{"id":...} field). Leave unset to disable notifications.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789
# Local hour (0-23) to send the daily digest. Default 9.
# TELEGRAM_DIGEST_HOUR=9

# --- Quick key ingest endpoint ----------------------------------------------
# POST /api/keys/ingest { "key": "...", "platform": "groq"? }
# If set, callers must send header  x-ingest-token: <this value>. Leave unset
# to keep the endpoint open on the trusted LAN. Also gates POST/PATCH/DELETE
# on /api/providers (custom-provider management).
# INGEST_TOKEN=choose-a-long-random-string

# --- Optional self-hosted OpenAI-compatible proxies on your LAN -------------
# Built-in "meridian" and "cliproxyapi" providers are off unless you point them
# at your own endpoint. (You can also add any OpenAI-compatible provider at
# runtime from the dashboard — Keys → مزوّدون مخصّصون.)
# MERIDIAN_BASE_URL=http://10.0.0.10:3456/v1
# CLIPROXY_BASE_URL=http://10.0.0.10:8317/v1
