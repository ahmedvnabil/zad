{
  "name": "zad",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "test": "npm run test -w server && npm run test -w client",
    "build": "npm run build -w server && npm run build -w client",
    "build:server": "npm run build -w server",
    "check:auth": "bash scripts/check-auth-coverage.sh",
    "postinstall": "bash scripts/install-hooks.sh 2>/dev/null || true"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0"
  },
  "overrides": {
    "@hono/node-server": "1.19.17",
    "@tailwindcss/vite": {
      "vite": "8.1.6"
    },
    "@vitejs/plugin-react": {
      "vite": "8.1.6"
    }
  }
}
